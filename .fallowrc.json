{
  "entry": [
    "app/assets/theme-init.js"
  ],
  "ignoreDependencies": [
    "vue-tsc"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "patterns": [
          "app/*.vue",
          "app/components/**",
          "app/composables/**",
          "app/i18n/**",
          "app/layouts/**",
          "app/middleware/**",
          "app/pages/**",
          "app/queries/**",
          "app/types/**",
          "app/utils/**"
        ]
      },
      {
        "name": "shared",
        "patterns": [
          "shared/**"
        ]
      },
      {
        "name": "tooling",
        "patterns": [
          "scripts/**",
          "*.config.ts"
        ]
      },
      {
        "name": "tests",
        "patterns": [
          "tests/**"
        ]
      },
      {
        "name": "assets",
        "patterns": [
          "app/assets/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "app",
        "allow": [
          "app",
          "shared",
          "assets"
        ]
      },
      {
        "from": "shared",
        "allow": [
          "shared"
        ]
      },
      {
        "from": "tooling",
        "allow": [
          "tooling",
          "shared",
          "assets"
        ]
      },
      {
        "from": "tests",
        "allow": [
          "tests",
          "app",
          "shared",
          "tooling"
        ]
      },
      {
        "from": "assets",
        "allow": [
          "assets"
        ]
      }
    ]
  }
}
