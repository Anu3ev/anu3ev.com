{
  "name": "anu3ev-portfolio",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt generate",
    "preview": "http-server .output/public --port 4173 --address 127.0.0.1 -c-1 --brotli --gzip",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check:content": "tsx scripts/validate-content.ts",
    "check": "pnpm check:content && pnpm lint && pnpm typecheck && pnpm test",
    "prebuild": "pnpm check:content && tsx scripts/prepare-admin.ts && tsx scripts/build-metadata.ts && tsx scripts/prepare-images.ts",
    "predev": "tsx scripts/prepare-admin.ts && tsx scripts/build-metadata.ts && tsx scripts/prepare-images.ts",
    "test:e2e": "playwright test --workers=1",
    "assets:prepare": "tsx scripts/prepare-images.ts",
    "release:plan": "tsx scripts/plan-release.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/content": "3.16.2",
    "gray-matter": "^4.0.3",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@sveltia/cms": "0.248.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "better-sqlite3": "12.5.0",
    "eslint": "^10.13.0",
    "http-server": "14.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
